#!/usr/bin/env bash
# harness — agent-harness をプロジェクトに導入・更新・吸い上げする CLI
#
#   harness init   [--source <path|git-url>] [--ref <branch|tag>] [--agents claude,codex]
#   harness update [--ref <branch|tag>]
#   harness status
#   harness diff
#   harness upstream <path>...
#   harness check  [--fast]
#   harness gc     [--days N] [--strict]  # docs の腐敗検知
#   harness doctor                        # 環境と導入状態の診断
#   harness self-install [--dir <dir>]   # `harness` を PATH に置く（Windows は harness.cmd も）
#   harness version
#
# 設計: DESIGN.md §6（所有権）, §8（コマンド）。依存は git と bash だけ。
# この CLI 自身も .harness/bin/harness（+ harness.cmd）としてプロジェクトに同梱されるので、
# clone した PC では `.harness/bin/harness update` がそのまま動く。
# PATH に置いた harness は、プロジェクト内では同梱コピーへ委譲する（版がプロジェクトに固定される）。
set -euo pipefail

DEFAULT_SOURCE="https://github.com/takumifukasawa/agent-harness.git"
MANIFEST_REL=".harness/manifest.json"
BEGIN_RE='<!-- harness:begin'
END_RE='<!-- harness:end -->'

# ---------------------------------------------------------------- util
die()  { echo "harness: $*" >&2; exit 1; }
info() { echo "harness: $*"; }
now() { date +%Y-%m-%d; }
ts() { date +%Y%m%d-%H%M%S; }

# 内容ハッシュ。フィルタを通さない生バイトで取る。
# 素の `git hash-object` は .gitattributes の text/eol と core.autocrlf を適用するので、CRLF 化しただけの
# 導入コピーを「未変更」と誤判定する。これに騙されるのは status の MODIFIED 判定、update の上書き判断、
# 検査 "installed copies in sync" の 3 つ全部（scripts/doctor.sh の content_eq と同じ方針）。
hash_of() { # file
  local h; h="$(git hash-object --no-filters "$1" 2>/dev/null || true)"
  [ -n "$h" ] || die "内容ハッシュを取れない: $1（git が要る）"
  printf '%s' "$h"
}

# grep -c は 0 件のとき "0" を出して exit 1 を返す。`|| echo 0` を足すと出力が "0\n0" になり、
# 続く整数比較が「integer expression expected」で失敗して条件が常に偽になる。数は必ずここを通す。
count_lines() { # 正規表現 ファイル → 整数
  local n; n="$(grep -c "$1" "$2" 2>/dev/null || true)"; n="${n%%[!0-9]*}"; printf '%s' "${n:-0}"
}

# 上書き前に変更前の内容を .harness/backup/<ts>/ へ退避する（ローカルの変更を黙って捨てない）
backup_file() { # backup_dir dest_rel
  mkdir -p "$1/$(dirname "$2")" && cp "$ROOT/$2" "$1/$2"
}

project_root() {
  local r; r="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  # Git for Windows は C:/... を返す。MSYS の /c/... 形式に揃える（比較やメッセージの一貫性のため）
  if command -v cygpath >/dev/null 2>&1; then cygpath -u "$r"; else echo "$r"; fi
}

# 「同じスクリプトか」はパス文字列や -ef で判定しない（Windows で C:/ と /c/ と /tmp が混在し一致しない）。
# 内容が同一なら同じものとして扱う。この用途（委譲の抑止、自己上書きの回避）では内容一致で十分。
# ここだけは改行コードの違いを無視する（hash_of の生バイト比較とは別）。CRLF 化しただけの同梱コピーを
# 「別のスクリプト」と見なすと、正本側の bin/harness が壊れた同梱コピーへ exec してしまい、直す道が塞がる。
same_script() { # a b
  [ -f "$1" ] && [ -f "$2" ] || return 1
  [ "$(tr -d '\r' <"$1" | git hash-object --stdin)" = "$(tr -d '\r' <"$2" | git hash-object --stdin)" ]
}

# この CLI が agent-harness リポジトリの中から実行されているなら、そのパスを返す
self_repo() {
  local here
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
  [ -n "$here" ] && [ -f "$here/../VERSION" ] && [ -d "$here/../harness" ] && (cd "$here/.." && pwd) || echo ""
}

# source（ローカルパス or git URL）を解決し、ペイロードのあるディレクトリを返す
# git URL の場合は ~/.cache/agent-harness/<hash> に clone / fetch する
resolve_source() {
  local src="$1" ref="${2:-}"
  if [ -d "$src" ]; then
    (cd "$src" && pwd); return
  fi
  local cache="${HOME}/.cache/agent-harness/$(printf '%s' "$src" | sha256sum | cut -c1-12)"
  if [ ! -d "$cache/.git" ]; then
    info "fetching $src" >&2
    git clone --quiet "$src" "$cache" >&2 || die "clone に失敗: $src"
  else
    git -C "$cache" fetch --quiet --tags origin >&2 || die "fetch に失敗: $src"
  fi
  if [ -n "$ref" ]; then
    git -C "$cache" checkout --quiet "$ref" >&2 || die "ref が見つからない: $ref"
    git -C "$cache" pull --quiet --ff-only origin "$ref" >/dev/null 2>&1 || true
  else
    local def
    def="$(git -C "$cache" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|origin/||' || echo main)"
    git -C "$cache" checkout --quiet "$def" >&2 && git -C "$cache" pull --quiet --ff-only origin "$def" >&2 || true
  fi
  echo "$cache"
}

# ---------------------------------------------------------------- manifest
# 1 エントリ 1 行の JSON。bash だけで読めるよう、書式を固定する。
#   {"path":"...","src":"...","ownership":"managed|seed|merge|generated","sha256":"...","source_sha256":"..."}
manifest_path() { echo "$ROOT/$MANIFEST_REL"; }

manifest_get() { # key
  sed -n "s/^  \"$1\": *\"\(.*\)\",\{0,1\}$/\1/p" "$(manifest_path)" | head -1
}

# path<TAB>src<TAB>ownership<TAB>sha256<TAB>source_sha256
manifest_entries() {
  [ -f "$(manifest_path)" ] || return 0
  grep '^    {"path"' "$(manifest_path)" | sed -E \
    's/.*"path":"([^"]*)".*"src":"([^"]*)".*"ownership":"([^"]*)".*"sha256":"([^"]*)".*"source_sha256":"([^"]*)".*/\1\t\2\t\3\t\4\t\5/'
}

# 収集したエントリ（配列 ENTRIES、TSV 行）から manifest を書く
write_manifest() {
  local version="$1" source="$2" ref="$3" agents="$4"
  local out; out="$(manifest_path)"
  mkdir -p "$(dirname "$out")"
  {
    echo "{"
    echo "  \"harness_version\": \"$version\","
    echo "  \"source\": \"$source\","
    echo "  \"source_ref\": \"$ref\","
    echo "  \"installed_at\": \"$(now)\","
    echo "  \"agents\": \"$agents\","
    echo "  \"files\": ["
    local n=${#ENTRIES[@]} i=0 e
    for e in "${ENTRIES[@]}"; do
      i=$((i + 1))
      IFS=$'\t' read -r p s o h sh <<<"$e"
      printf '    {"path":"%s","src":"%s","ownership":"%s","sha256":"%s","source_sha256":"%s"}%s\n' \
        "$p" "$s" "$o" "$h" "$sh" "$([ $i -lt $n ] && echo ',')"
    done
    echo "  ]"
    echo "}"
  } >"$out"
}

# ---------------------------------------------------------------- install plan
# ペイロード → プロジェクトの対応表を TSV で出す: src<TAB>dest<TAB>ownership
# src は $PAYLOAD 配下の相対パス（"@self" は CLI 自身）
plan() {
  local agents="$1" f rel
  # CLI 自身（+ Windows の PowerShell / cmd から呼ぶためのシム）
  echo -e "@self\t.harness/bin/harness\tmanaged"
  echo -e "@self-cmd\t.harness/bin/harness.cmd\tmanaged"
  # スクリプト
  for f in "$PAYLOAD/scripts/"*; do
    [ -f "$f" ] || continue
    echo -e "scripts/$(basename "$f")\t.harness/scripts/$(basename "$f")\tmanaged"
  done
  echo -e "checks.seed.sh\t.harness/checks.sh\tseed"
  # 状態の雛形
  for f in "$PAYLOAD/state-template/"*; do
    [ -f "$f" ] || continue
    echo -e "state-template/$(basename "$f")\t.harness/state-template/$(basename "$f")\tmanaged"
  done
  # スキル → .agents/skills/
  while IFS= read -r f; do
    rel="${f#"$PAYLOAD"/skills/}"
    echo -e "skills/$rel\t.agents/skills/$rel\tmanaged"
    case ",$agents," in *,claude,*) echo -e "skills/$rel\t.claude/skills/$rel\tmanaged";; esac
  done < <(find "$PAYLOAD/skills" -type f | sort)
  # docs 雛形 → docs/（seed）
  while IFS= read -r f; do
    rel="${f#"$PAYLOAD"/docs-template/}"
    echo -e "docs-template/$rel\tdocs/$rel\tseed"
  done < <(find "$PAYLOAD/docs-template" -type f ! -name .gitkeep | sort)
  # AGENTS.md（merge）
  echo -e "AGENTS.core.md\tAGENTS.md\tmerge"
  # Claude アダプタ
  case ",$agents," in *,claude,*)
    echo -e "adapters/claude/CLAUDE.md.template\tCLAUDE.md\tmanaged"
    echo -e "adapters/claude/settings.fragment.json\t.harness/adapters/claude.settings.fragment.json\tmanaged"
    for r in implementer reviewer; do
      echo -e "docs-template/roles/$r.md\t.claude/agents/$r.md\tgenerated"
    done
  ;; esac
  # Codex アダプタ: 役割文を明示呼び出し用スキルに（$role-implementer）
  case ",$agents," in *,codex,*)
    for r in implementer reviewer; do
      echo -e "docs-template/roles/$r.md\t.agents/skills/role-$r/SKILL.md\tgenerated"
    done
  ;; esac
  # git hooks
  echo -e "@pre-commit\t.githooks/pre-commit\tmanaged"
}

# ペイロード側の内容をファイルに書き出す（src の種類ごとの生成を含む）
render_src() { # src dest_tmp
  local src="$1" tmp="$2"
  case "$src" in
    @self)
      if [ -n "$SELF_PATH" ]; then cp "$SELF_PATH" "$tmp"; else cp "$PAYLOAD/../bin/harness" "$tmp"; fi ;;
    @self-cmd) write_cmd_shim "$tmp" ;;
    AGENTS.core.md)
      # マーカーの版はペイロードの VERSION から埋める（手で合わせない）
      sed "s/<!-- harness:begin v=[^ ]* -->/<!-- harness:begin v=${HVER} -->/" "$PAYLOAD/$src" >"$tmp" ;;
    @pre-commit)
      cat >"$tmp" <<'EOF'
#!/usr/bin/env bash
# agent-harness managed: 速い検査だけを pre-commit で回す（有効化: git config core.hooksPath .githooks）
exec bash "$(git rev-parse --show-toplevel)/.harness/scripts/check.sh" --fast
EOF
      ;;
    *) cp "$PAYLOAD/$src" "$tmp" ;;
  esac
}

# Windows 用シム。cmd / PowerShell から `harness ...` を bash の本体へ渡す（Git for Windows の bash）。
write_cmd_shim() { # dest
  printf '@echo off\r\nbash "%%~dp0harness" %%*\r\n' >"$1"
}

# docs/roles/<r>.md → .claude/agents/<r>.md（kind=agent）または .agents/skills/role-<r>/SKILL.md（kind=skill）
render_agent() { # role_src_file dest_tmp role_name kind
  local role="$1" tmp="$2" name="$3" kind="${4:-agent}" desc
  # description は H1（例: "# implementer — 実装（タスク 1 つにつき 1 体）"）から取る
  desc="$(grep -m1 '^# ' "$role" | sed 's/^# *//; s/"/\\"/g')"
  {
    echo "---"
    if [ "$kind" = "skill" ]; then
      echo "name: role-$name"
      echo "description: 役割「$name」として動く。統括（task-orchestrate）から指示を受けて呼ばれる。${desc:-}"
    else
      echo "name: $name"
      echo "description: ${desc:-agent-harness role $name}"
      echo "model: inherit"
    fi
    echo "---"
    echo
    echo "<!-- generated by agent-harness from docs/roles/$name.md — edit the source, not this file -->"
    echo
    cat "$role"
  } >"$tmp"
}

# AGENTS.md の managed ブロックを差し替え / 挿入する。ブロック外（プロジェクトの記述）は必ず残す。
#   - ブロックが複数あれば 1 つに畳む（最初のブロックの位置に新版を置き、残りの領域は落とす）
#   - end マーカーが見つからない begin は、その 1 行だけを落とす。ファイル末尾までを巻き込んで消すと
#     プロジェクトの記述が飛ぶので、残骸を残す方を選ぶ（残骸は呼び出し側が案内する）
merge_agents_md() { # block_file dest
  local block="$1" dest="$2" tmp
  tmp="$(mktemp)"
  if [ -f "$dest" ] && grep -q "$BEGIN_RE" "$dest"; then
    awk -v blk="$block" -v b="$BEGIN_RE" -v e="$END_RE" '
      NR==FNR {                                  # 1 周目: 落とす行に印を付ける
        if (index($0,b)==1) { if (open) del[open]=1; open=FNR }
        else if (open && index($0,e)==1) { for (i=open;i<=FNR;i++) del[i]=1; open=0 }
        next
      }
      FNR==1 && open { del[open]=1; open=0 }     # 2 周目の頭: end の無い begin は 1 行だけ落とす
      {
        if (del[FNR]) { if (!put) { while ((getline l < blk) > 0) print l; put=1 } ; next }
        print
      }' "$dest" "$dest" >"$tmp"
  elif [ -f "$dest" ]; then
    { cat "$block"; echo; cat "$dest"; } >"$tmp"
  else
    { cat "$block"; echo; echo "# プロジェクト固有のルール"; echo; echo "<!-- ここから下はプロジェクトが書く。目的、ディレクトリ構成、ビルド/テストコマンド、規約、やらないこと -->"; } >"$tmp"
  fi
  mv "$tmp" "$dest"
}

# managed ブロックだけを取り出してハッシュ。ブロックが複数あれば全部を連結して見る
# （先頭だけを見ると、ブロックが重複していても「未変更」になり、status も update も気付かない）。
block_hash() { # file
  awk -v b="$BEGIN_RE" -v e="$END_RE" 'index($0,b)==1{p=1} p{print} p&&index($0,e)==1{p=0}' "$1" | git hash-object --stdin
}

ensure_gitignore() {
  local gi="$ROOT/.gitignore" line
  for line in ".harness/state/" ".harness/backup/" ".harness/conflicts/"; do
    grep -qxF "$line" "$gi" 2>/dev/null || echo "$line" >>"$gi"
  done
}

# Windows の core.autocrlf で bash スクリプトが CRLF になると動かず、ハッシュ比較も狂う。LF を強制する。
ensure_gitattributes() {
  local ga="$ROOT/.gitattributes" line
  # ハッシュ比較の対象（managed / generated とその生成元）はすべて LF 固定にする
  for line in ".harness/** text eol=lf" ".harness/bin/harness.cmd text eol=crlf" ".githooks/** text eol=lf" ".agents/** text eol=lf" ".claude/** text eol=lf" "docs/roles/** text eol=lf" "AGENTS.md text eol=lf" "CLAUDE.md text eol=lf"; do
    grep -qxF "$line" "$ga" 2>/dev/null || echo "$line" >>"$ga"
  done
}

# サブディレクトリの AGENTS.md の隣に CLAUDE.md アダプタを置く
ensure_nested_claude_md() {
  local f d
  while IFS= read -r f; do
    d="$(dirname "$f")"
    [ "$d" = "$ROOT" ] && continue
    if [ ! -f "$d/CLAUDE.md" ]; then
      cp "$PAYLOAD/adapters/claude/CLAUDE.md.template" "$d/CLAUDE.md"
      info "  + ${d#"$ROOT"/}/CLAUDE.md (adapter for nested AGENTS.md)"
    fi
  done < <(find "$ROOT" -name AGENTS.md -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/.harness/*')
}

# ---------------------------------------------------------------- apply (init/update 共通)
# 各 plan 行を所有権規則で適用し、ENTRIES を組み立てる
apply_plan() { # agents mode(init|update)
  local agents="$1" mode="$2"
  local backup="$ROOT/.harness/backup/$(ts)" conflicts="$ROOT/.harness/conflicts"
  declare -A OLD_HASH OLD_SRC_HASH
  local p s o h sh
  while IFS=$'\t' read -r p s o h sh; do OLD_HASH["$p"]="$h"; OLD_SRC_HASH["$p"]="$sh"; done < <(manifest_entries)

  ENTRIES=()
  local n_new=0 n_up=0 n_res=0 n_keep=0 n_conf=0 n_seed=0
  local src dest own tmp abs newhash curhash srchash
  while IFS=$'\t' read -r src dest own; do
    abs="$ROOT/$dest"; tmp="$(mktemp)"
    srchash=""
    case "$own" in
      generated)
        # 生成元は プロジェクト側の seed（docs/roles/x.md）。無ければペイロードの雛形から。
        local rolename rolefile kind="agent"
        rolename="$(basename "$src" .md)"
        rolefile="$ROOT/docs/roles/$rolename.md"
        [ -f "$rolefile" ] || rolefile="$PAYLOAD/$src"
        case "$dest" in .agents/skills/role-*) kind="skill";; esac
        render_agent "$rolefile" "$tmp" "$rolename" "$kind"
        srchash="$(hash_of "$rolefile")"
        ;;
      merge) render_src "$src" "$tmp" ;;
      *)     render_src "$src" "$tmp" ;;
    esac
    newhash="$(hash_of "$tmp")"

    if [ "$own" = "seed" ]; then
      if [ -f "$abs" ]; then n_keep=$((n_keep + 1)); else
        mkdir -p "$(dirname "$abs")"; cp "$tmp" "$abs"; n_seed=$((n_seed + 1)); info "  seed  $dest"
      fi
      ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"-"$'\t'"-")
    elif [ "$own" = "merge" ]; then
      # AGENTS.md: managed ブロックだけを現行版に戻す。ブロック外（プロジェクトの記述）は触らない。
      # ブロックの中を手で直していても conflicts に逃がさず直す（ブロックは harness が正本。決定 0002）。
      local nbegin=0 nend=0
      if [ -f "$abs" ]; then
        nbegin="$(count_lines "$BEGIN_RE" "$abs")"; nend="$(count_lines "$END_RE" "$abs")"
      fi
      if [ "$nbegin" -eq 1 ] && [ "$nend" -eq 1 ]; then
        curhash="$(block_hash "$abs")"
        if [ "$curhash" = "$newhash" ]; then
          n_keep=$((n_keep + 1)); ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"$newhash"$'\t'"-"); rm -f "$tmp"; continue
        fi
        backup_file "$backup" "$dest"
        merge_agents_md "$tmp" "$abs"; n_up=$((n_up + 1))
        info "  merge $dest (managed ブロックを現行版に戻した。変更前: ${backup#"$ROOT"/}/$dest)"
      elif [ "$nbegin" -ge 1 ]; then
        # マーカーが壊れている（ブロックの重複、end の消失）。1 対に畳む。
        backup_file "$backup" "$dest"
        merge_agents_md "$tmp" "$abs"; n_up=$((n_up + 1))
        info "  merge $dest (マーカーが壊れていた: begin=$nbegin end=$nend → 1 対に畳んだ。変更前: ${backup#"$ROOT"/}/$dest)"
        [ "$nend" -lt "$nbegin" ] && info "        end マーカーの無かったブロックの中身は消さずに残してある。要らなければ手で消す。"
      else
        merge_agents_md "$tmp" "$abs"; n_up=$((n_up + 1)); info "  merge $dest"
      fi
      ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"$(block_hash "$abs")"$'\t'"-")
    elif [ "$dest" = "CLAUDE.md" ]; then
      # CLAUDE.md は import スタブ。プロジェクトが書いた内容は残し、@AGENTS.md の行だけを保証する
      # （managed だが上書きはしない。テンプレを被せると既存の記述が消えるため。決定 0002）。
      if [ ! -f "$abs" ]; then
        mkdir -p "$(dirname "$abs")"; cp "$tmp" "$abs"; n_new=$((n_new + 1)); info "  +     $dest"
      else
        curhash="$(hash_of "$abs")"
        if [ "$curhash" = "$newhash" ]; then
          n_keep=$((n_keep + 1))
        elif [ "$curhash" = "${OLD_HASH[$dest]:-}" ]; then
          # 導入時のまま = プロジェクトは何も書いていない。新しい雛形に入れ替える
          backup_file "$backup" "$dest"; cp "$tmp" "$abs"; n_up=$((n_up + 1)); info "  update $dest"
        elif ! grep -q '^@AGENTS\.md' "$abs"; then
          backup_file "$backup" "$dest"
          { echo "@AGENTS.md"; echo; cat "$abs"; } >"$tmp.new" && mv "$tmp.new" "$abs"
          n_up=$((n_up + 1)); info "  merge $dest (@AGENTS.md の import を足した。プロジェクトの記述は残す)"
        else
          n_keep=$((n_keep + 1))   # プロジェクトが書いた内容がある。import はある。触らない
        fi
      fi
      ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"$(hash_of "$abs")"$'\t'"$srchash")
    else
      # managed / generated: harness が正本。ローカルの変更は元に戻す（変更前は backup へ）
      if [ ! -f "$abs" ]; then
        mkdir -p "$(dirname "$abs")"; cp "$tmp" "$abs"; n_new=$((n_new + 1)); info "  +     $dest"
      else
        curhash="$(hash_of "$abs")"
        if [ "$curhash" = "$newhash" ]; then
          n_keep=$((n_keep + 1))
        elif [ -z "${OLD_HASH[$dest]:-}" ]; then
          # manifest に無いのに存在する = harness が入れたのではないファイル。壊さず conflict に
          mkdir -p "$conflicts/$(dirname "$dest")"; cp "$tmp" "$conflicts/$dest.new"; n_conf=$((n_conf + 1))
          info "  CONFLICT $dest (exists, not from harness) -> .harness/conflicts/$dest.new"
          ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"$curhash"$'\t'"$srchash")
          rm -f "$tmp"; continue
        elif [ "$curhash" = "${OLD_HASH[$dest]}" ]; then
          backup_file "$backup" "$dest"
          cp "$tmp" "$abs"; n_up=$((n_up + 1)); info "  update $dest"
        else
          # 導入時から変わっている（手で編集、CRLF 化、生成物の drift）。正本の内容に戻す。
          backup_file "$backup" "$dest"
          cp "$tmp" "$abs"; n_res=$((n_res + 1))
          if [ "$own" = "generated" ]; then
            info "  restore $dest (生成物。直すなら生成元 docs/roles/ を直す。変更前: ${backup#"$ROOT"/}/$dest)"
          else
            info "  restore $dest (ローカルの変更を戻した。変更前: ${backup#"$ROOT"/}/$dest)"
          fi
        fi
      fi
      newhash="$(hash_of "$abs")"
      ENTRIES+=("$dest"$'\t'"$src"$'\t'"$own"$'\t'"$newhash"$'\t'"$srchash")
    fi
    rm -f "$tmp"
  done < <(plan "$agents")

  chmod +x "$ROOT/.harness/bin/harness" "$ROOT/.githooks/pre-commit" "$ROOT/.harness/scripts/"*.sh 2>/dev/null || true
  ensure_gitignore
  ensure_gitattributes
  case ",$agents," in *,claude,*) ensure_nested_claude_md;; esac
  git -C "$ROOT" config core.hooksPath .githooks 2>/dev/null || true

  echo
  info "$mode done: new=$n_new updated=$n_up restored=$n_res unchanged=$n_keep seeded=$n_seed conflicts=$n_conf"
  [ "$n_res" -gt 0 ] && info "restored: managed / generated は harness が正本なので正本の内容に戻した。残したい変更があるなら .harness/backup/ から拾い、harness upstream で正本へ戻してから update する"
  [ "$n_conf" -gt 0 ] && info "conflicts: .harness/conflicts/ を見て、新版を採るか harness upstream で戻すか決める"
  [ -d "$backup" ] && info "backup: ${backup#"$ROOT"/}"
  return 0
}

# .claude/settings.json に断片をマージする。node があれば自動、無ければ手順を案内。
# 管理するのは「permissions.deny の断片にある項目」と「hooks のうち command に .harness/ を含む項目」だけ。
# それ以外の項目（プロジェクトが書いたもの）は触らない。上書き前にバックアップ。
merge_claude_settings() {
  local agents="$1"
  case ",$agents," in *,claude,*) ;; *) return 0;; esac
  local frag="$PAYLOAD/adapters/claude/settings.fragment.json" dest="$ROOT/.claude/settings.json"
  [ -f "$frag" ] || return 0
  if ! command -v node >/dev/null 2>&1; then
    echo
    info "node が無いので .claude/settings.json は自動マージしない。断片を手で反映:"
    info "  .harness/adapters/claude.settings.fragment.json"
    return 0
  fi
  mkdir -p "$ROOT/.claude"
  local changed
  changed="$(node - "$frag" "$dest" <<'EOF'
const fs = require('fs');
const [frag, dest] = process.argv.slice(2);
const f = JSON.parse(fs.readFileSync(frag, 'utf8'));
let s = {};
if (fs.existsSync(dest)) {
  try { s = JSON.parse(fs.readFileSync(dest, 'utf8')); }
  catch (e) { console.error('settings.json が JSON として読めない: ' + e.message); process.exit(3); }
}
const before = JSON.stringify(s);
// permissions.deny: 断片の項目を足す（重複なし）。プロジェクトの項目は残す
if (f.permissions && Array.isArray(f.permissions.deny)) {
  s.permissions = s.permissions || {};
  const cur = Array.isArray(s.permissions.deny) ? s.permissions.deny : [];
  for (const d of f.permissions.deny) if (!cur.includes(d)) cur.push(d);
  s.permissions.deny = cur;
}
// hooks: 各イベントで、command に ".harness/" を含む既存項目を外し、断片の項目を足す
const isHarness = (entry) => Array.isArray(entry.hooks) && entry.hooks.some(h => typeof h.command === 'string' && h.command.includes('.harness/'));
if (f.hooks) {
  s.hooks = s.hooks || {};
  for (const ev of Object.keys(f.hooks)) {
    const kept = (Array.isArray(s.hooks[ev]) ? s.hooks[ev] : []).filter(e => !isHarness(e));
    s.hooks[ev] = kept.concat(f.hooks[ev]);
  }
}
const after = JSON.stringify(s);
if (before === after) { console.log('unchanged'); process.exit(0); }
fs.writeFileSync(dest + '.harness-new', JSON.stringify(s, null, 2) + '\n');
console.log('changed');
EOF
)" || { info "  settings.json のマージに失敗（$changed）。断片を手で反映: .harness/adapters/claude.settings.fragment.json"; return 0; }
  if [ "$changed" = "changed" ]; then
    if [ -f "$dest" ]; then
      local b="$ROOT/.harness/backup/$(ts)"; mkdir -p "$b/.claude"; cp "$dest" "$b/.claude/settings.json"
    fi
    mv "$dest.harness-new" "$dest"
    info "  merge .claude/settings.json (deny + .harness/ hooks。プロジェクトの項目は保持)"
  fi
}

# ---------------------------------------------------------------- commands
cmd_init() {
  local source="" ref="" agents="claude,codex"
  while [ $# -gt 0 ]; do
    case "$1" in
      --source) source="$2"; shift 2;;
      --ref) ref="$2"; shift 2;;
      --agents) agents="$2"; shift 2;;
      *) die "unknown option: $1";;
    esac
  done
  ROOT="$(project_root)"
  [ -f "$(manifest_path)" ] && die "既に導入済み（$MANIFEST_REL がある）。harness update を使う"
  [ -z "$source" ] && source="$(self_repo)"
  [ -z "$source" ] && source="$DEFAULT_SOURCE"
  # ローカルパスは絶対パスにして保存する（相対のままだと別ディレクトリからの update で壊れる）
  [ -d "$source" ] && source="$(cd "$source" && pwd)"
  local srcdir; srcdir="$(resolve_source "$source" "$ref")"
  PAYLOAD="$srcdir/harness"; SELF_PATH="$srcdir/bin/harness"
  [ -d "$PAYLOAD" ] || die "ペイロードが無い: $PAYLOAD"
  local version; version="$(tr -d '\r\n' <"$srcdir/VERSION")"; HVER="$version"
  info "init  project=$ROOT"
  info "      source=$source ref=${ref:-default} version=$version agents=$agents"
  apply_plan "$agents" init
  write_manifest "$version" "$source" "$ref" "$agents"
  merge_claude_settings "$agents"
  echo
  info "次: docs/spec/ に何を作るかを書き、.harness/checks.sh に検査を登録する。セッション開始は session-catchup。"
  info "     導入直後の環境確認は harness doctor。"
}

# update は .harness/bin/harness 自身を上書きする。実行中のスクリプトを上書きすると bash が壊れた内容を
# 読み続けるので、同梱コピーから起動されたときは一時ファイルに自分を写してそこから再実行する。
reexec_if_vendored() {
  [ -n "${HARNESS_REEXEC:-}" ] && return 0
  local me="${BASH_SOURCE[0]}" vendored="$ROOT/.harness/bin/harness" tmp
  same_script "$me" "$vendored" || return 0
  tmp="$(mktemp)"; cp "$me" "$tmp"
  HARNESS_REEXEC=1 HARNESS_REEXEC_TMP="$tmp" exec bash "$tmp" update "$@"
}

cmd_update() {
  local ref=""
  ROOT="$(project_root)"
  reexec_if_vendored "$@"
  [ -n "${HARNESS_REEXEC_TMP:-}" ] && trap 'rm -f "$HARNESS_REEXEC_TMP"' EXIT
  while [ $# -gt 0 ]; do
    case "$1" in --ref) ref="$2"; shift 2;; *) die "unknown option: $1";; esac
  done
  [ -f "$(manifest_path)" ] || die "未導入（$MANIFEST_REL が無い）。harness init を使う"
  local source agents oldver
  source="$(manifest_get source)"; agents="$(manifest_get agents)"; oldver="$(manifest_get harness_version)"
  [ -z "$ref" ] && ref="$(manifest_get source_ref)"
  local srcdir; srcdir="$(resolve_source "$source" "$ref")"
  PAYLOAD="$srcdir/harness"; SELF_PATH="$srcdir/bin/harness"
  local version; version="$(tr -d '\r\n' <"$srcdir/VERSION")"; HVER="$version"
  info "update $oldver -> $version  (source=$source ref=${ref:-default})"
  if [ "$oldver" != "$version" ] && [ -f "$srcdir/CHANGELOG.md" ]; then
    echo; echo "── CHANGELOG（$oldver より新しい分）"
    awk -v old="## [$oldver]" 'index($0,old)==1{exit} /^## \[/{p=1} p' "$srcdir/CHANGELOG.md" | sed 's/^/   /'
    echo
  fi
  apply_plan "$agents" update
  write_manifest "$version" "$source" "$ref" "$agents"
  merge_claude_settings "$agents"
}

cmd_status() {
  ROOT="$(project_root)"
  [ -f "$(manifest_path)" ] || die "未導入（$MANIFEST_REL が無い）"
  local ver src ref; ver="$(manifest_get harness_version)"; src="$(manifest_get source)"; ref="$(manifest_get source_ref)"
  echo "harness $ver  source=$src ref=${ref:-default}  installed=$(manifest_get installed_at)"
  if [ -d "$src" ] && [ -f "$src/VERSION" ]; then
    local latest; latest="$(cat "$src/VERSION")"
    [ "$latest" != "$ver" ] && echo "  latest at source: $latest  (harness update で取り込む)"
  fi
  echo
  local p s o h sh cur state n_mod=0 n_miss=0
  while IFS=$'\t' read -r p s o h sh; do
    if [ ! -e "$ROOT/$p" ]; then state="missing"; n_miss=$((n_miss + 1))
    elif [ "$o" = "seed" ]; then state="seed"
    elif [ "$o" = "merge" ]; then cur="$(block_hash "$ROOT/$p")"; [ "$cur" = "$h" ] && state="unchanged" || { state="MODIFIED"; n_mod=$((n_mod + 1)); }
    else
      cur="$(hash_of "$ROOT/$p")"
      if [ "$cur" = "$h" ]; then state="unchanged"; else state="MODIFIED"; n_mod=$((n_mod + 1)); fi
      if [ "$o" = "generated" ] && [ -n "$sh" ] && [ "$sh" != "-" ]; then
        local rolefile="$ROOT/docs/roles/$(basename "$s")"
        [ -f "$rolefile" ] && [ "$(hash_of "$rolefile")" != "$sh" ] && state="$state, source-changed (harness update で再生成)"
      fi
    fi
    printf '  %-10s %-9s %s\n' "$o" "$state" "$p"
  done < <(manifest_entries)
  echo
  echo "modified=$n_mod missing=$n_miss   (MODIFIED な managed は harness diff で確認し、汎用なら harness upstream で戻す)"
}

cmd_diff() {
  ROOT="$(project_root)"
  [ -f "$(manifest_path)" ] || die "未導入"
  local src ref; src="$(manifest_get source)"; ref="$(manifest_get source_ref)"
  local srcdir; srcdir="$(resolve_source "$src" "$ref")"
  PAYLOAD="$srcdir/harness"; SELF_PATH="$srcdir/bin/harness"; HVER="$(tr -d '\r\n' <"$srcdir/VERSION")"
  local p s o h sh cur tmp any=0
  while IFS=$'\t' read -r p s o h sh; do
    [ "$o" = "seed" ] && continue
    [ -f "$ROOT/$p" ] || continue
    if [ "$o" = "merge" ]; then cur="$(block_hash "$ROOT/$p")"; else cur="$(hash_of "$ROOT/$p")"; fi
    [ "$cur" = "$h" ] && continue
    any=1; tmp="$(mktemp)"
    if [ "$o" = "generated" ]; then echo "── $p: generated（生成元 docs/roles を直すのが正。この差分は再生成で消える）"; rm -f "$tmp"; continue; fi
    render_src "$s" "$tmp"
    echo "── $p  (source: $s)"
    if [ "$o" = "merge" ]; then
      diff -u "$tmp" <(awk -v b="$BEGIN_RE" -v e="$END_RE" 'index($0,b)==1{q=1} q{print} q&&index($0,e)==1{q=0}' "$ROOT/$p") || true
    else
      diff -u "$tmp" "$ROOT/$p" || true
    fi
    rm -f "$tmp"
  done < <(manifest_entries)
  [ "$any" = 0 ] && echo "差分なし（managed ファイルは導入時のまま）"
  return 0
}

cmd_upstream() {
  ROOT="$(project_root)"
  [ -f "$(manifest_path)" ] || die "未導入"
  [ $# -gt 0 ] || die "usage: harness upstream <path>..."
  local src; src="$(manifest_get source)"
  [ -d "$src" ] || die "source が git URL ($src)。agent-harness を clone し、manifest の source をそのローカルパスに書き換えてから実行する"
  local p s o h sh target
  for target in "$@"; do
    target="${target#./}"
    local found=0
    while IFS=$'\t' read -r p s o h sh; do
      [ "$p" = "$target" ] || continue
      found=1
      case "$o" in
        seed) die "$p は seed（プロジェクトの資産）。上流に戻すものではない";;
        generated) die "$p は生成物。生成元 docs/roles/ を直し、そちらを共有する";;
      esac
      case "$s" in @*) die "$p は CLI 内部生成。bin/harness を直す";; esac
      if grep -qiE 'password|secret|token|api[_-]?key' "$ROOT/$p"; then
        info "WARN: $p に秘密情報らしき語がある。共有物になるので確認する"
      fi
      if [ "$o" = "merge" ]; then
        # 正本には必ずブロック 1 つ。ここだけは先頭のブロックで打ち切る（万一重複していても
        # 壊れた正本を配らない。重複は harness update が 1 対に畳む）。
        awk -v b="$BEGIN_RE" -v e="$END_RE" 'index($0,b)==1{q=1} q{print} q&&index($0,e)==1{exit}' "$ROOT/$p" >"$src/harness/$s"
      else
        cp "$ROOT/$p" "$src/harness/$s"
      fi
      info "upstream $p -> $src/harness/$s"
    done < <(manifest_entries)
    [ "$found" = 1 ] || die "manifest に無い: $target"
  done
  echo
  info "次: $src でレビュー → commit → CHANGELOG.md に「プロジェクト側で必要な作業」→ VERSION を上げる"
}

cmd_check() {
  ROOT="$(project_root)"
  [ -f "$ROOT/.harness/scripts/check.sh" ] || die "未導入（.harness/scripts/check.sh が無い）"
  exec bash "$ROOT/.harness/scripts/check.sh" "$@"
}

cmd_gc() {
  ROOT="$(project_root)"
  [ -f "$ROOT/.harness/scripts/gc.sh" ] || die "gc.sh が無い（harness update で入る）"
  exec bash "$ROOT/.harness/scripts/gc.sh" "$@"
}

cmd_doctor() {
  ROOT="$(project_root)"
  if [ ! -f "$ROOT/.harness/scripts/doctor.sh" ]; then
    # 未導入は「診断自体ができない環境不備」= exit 2（doctor.sh 側の判定と合わせる）
    echo "harness doctor: 導入コピーが無い（$ROOT/.harness/scripts/doctor.sh が見つからない）" >&2
    echo "  直し方: このディレクトリで harness init を実行する" >&2
    echo "          例: bash <agent-harness を clone した場所>/bin/harness init --source <同じ場所>" >&2
    exit 2
  fi
  exec bash "$ROOT/.harness/scripts/doctor.sh" "$@"
}

cmd_version() {
  local r; r="$(self_repo)"
  if [ -n "$r" ]; then echo "harness (repo) $(tr -d '\r\n' <"$r/VERSION")"; else
    ROOT="$(project_root)"; [ -f "$(manifest_path)" ] && echo "harness (installed) $(manifest_get harness_version)" || echo "harness (standalone)"
  fi
}

# `harness` を PATH 上に置く。Windows では harness.cmd も置き、PowerShell / cmd から使えるようにする。
cmd_self_install() {
  local dir=""
  while [ $# -gt 0 ]; do case "$1" in --dir) dir="$2"; shift 2;; *) die "unknown option: $1";; esac; done
  local me="${BASH_SOURCE[0]}"
  [ -f "$me" ] || die "標準入力から実行中は self-install できない。clone した bin/harness か、導入済みプロジェクトの .harness/bin/harness から実行する"
  local win=0; case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) win=1;; esac
  if [ -z "$dir" ]; then
    if [ "$win" = 1 ]; then dir="$HOME/bin"; else dir="$HOME/.local/bin"; fi
  fi
  mkdir -p "$dir"
  cp "$me" "$dir/harness" && chmod +x "$dir/harness"
  info "installed: $dir/harness"
  if [ "$win" = 1 ]; then
    write_cmd_shim "$dir/harness.cmd"; info "installed: $dir/harness.cmd (PowerShell / cmd 用)"
  fi
  case ":$PATH:" in *":$dir:"*) info "PATH に入っている。新しいシェルで 'harness version' を確認";;
    *) info "PATH に $dir を追加する:"
       if [ "$win" = 1 ]; then
         info "  PowerShell: [Environment]::SetEnvironmentVariable('Path', \$env:Path + ';$(cygpath -w "$dir" 2>/dev/null || echo "$dir")', 'User')"
         info "  Git Bash は ~/bin を自動で PATH に含める（新しいシェルで有効）"
       else
         info "  echo 'export PATH=\"$dir:\$PATH\"' >> ~/.bashrc"
       fi;;
  esac
}

usage() { sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# PATH 上の harness から呼ばれ、プロジェクトに同梱コピーがあれば、そちらへ委譲する（版をプロジェクトに固定）
maybe_delegate() {
  local cmd="${1:-}"
  case "$cmd" in init|self-install|version|--version|-v|""|help|-h|--help) return 0;; esac
  local root vendored me="${BASH_SOURCE[0]}"
  root="$(project_root)"; vendored="$root/.harness/bin/harness"
  [ -f "$vendored" ] || return 0
  same_script "$me" "$vendored" && return 0   # 既に同梱コピー（と同じ内容）を実行中
  exec bash "$vendored" "$@"
}

# ---------------------------------------------------------------- main
ROOT=""; PAYLOAD=""; SELF_PATH=""; HVER=""
maybe_delegate "$@"
case "${1:-}" in
  init)     shift; cmd_init "$@";;
  self-install) shift; cmd_self_install "$@";;
  update)   shift; cmd_update "$@";;
  status)   shift; cmd_status "$@";;
  diff)     shift; cmd_diff "$@";;
  upstream) shift; cmd_upstream "$@";;
  check)    shift; cmd_check "$@";;
  gc)       shift; cmd_gc "$@";;
  doctor)   shift; cmd_doctor "$@";;
  version|--version|-v) cmd_version;;
  ""|help|-h|--help) usage;;
  *) die "unknown command: $1 (harness help)";;
esac
